{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coche",
  "version": "0.2.0",
  "identifier": "fr.pandaroux.coche",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Coche",
        "width": 400,
        "height": 640,
        "minWidth": 340,
        "minHeight": 460,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Une to-do list qui donne envie d'avancer",
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "publisher": "Panda"
  }
}
